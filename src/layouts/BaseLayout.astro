---
interface Props {
  title: string;
  description?: string;
  image?: string;
  pageUrl?: string;
}

import "../styles/global.css";

const {
  title,
  description = "",
  image,
  pageUrl,
} = Astro.props;
const site = new URL(Astro.site ?? "/", Astro.url);
const absImage = image ? new URL(image.startsWith('/') ? image.slice(1) : image, site).href : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {absImage && (
      <>
        <meta property="og:image" content={absImage} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/easy-blog/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/easy-blog/">easy-blog</a>
      <p class="site-subtitle">気になるページのレビュー</p>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <small><a href={site}>Generated by easy-blog</a></small>
    </footer>
  </body>
</html>