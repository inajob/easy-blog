---
interface Props {
  title: string;
  description?: string;
}

import "../styles/global.css";

const { title, description = "" } = Astro.props;
const site = new URL(Astro.site ?? "/", Astro.url);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/easy-blog/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/easy-blog/">easy-blog</a>
      <p class="site-subtitle">気になるページのレビュー</p>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <small><a href={site}>Generated by easy-blog</a></small>
    </footer>
  </body>
</html>