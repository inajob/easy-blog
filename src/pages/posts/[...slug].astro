---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Awaited<ReturnType<typeof getCollection>>[number];
}

const { post } = Astro.props;
const { Content } = await render(post);
const youtubeEmbeds = post.data.youtube ?? [];

// 関連記事: 同じタグが多い順（タグ数でスコア）、最大3件
const allPosts = await getCollection("posts");
const related = allPosts
  .filter((p) => p.slug !== post.slug)
  .map((p) => ({
    post: p,
    score: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
  }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime())
  .slice(0, 3)
  .map((x) => x.post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  pageUrl={new URL(Astro.url.pathname, Astro.site).href}
>
  <nav class="breadcrumb">
    <a href="/easy-blog/">← 記事一覧</a>
  </nav>
  <article class="post">
    <header>
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString("ja-JP")}
      </time>
      <h1>{post.data.title}</h1>
      {
        post.data.tags.length > 0 && (
          <ul class="tags">
            {post.data.tags.map((tag) => (
              <li><a href={`/easy-blog/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>
            ))}
          </ul>
        )
      }
      <p class="post-source">
        レビュー元: <a href={post.data.url} rel="noopener">{post.data.sourceTitle ?? post.data.url}</a>
      </p>
    </header>
    {post.data.image && (
      <img class="post-og-image" src={post.data.image} alt="" loading="eager" />
    )}
    <div class="post-body">
      <Content />
      {
        youtubeEmbeds.length > 0 && (
          <div class="post-embeds">
            {youtubeEmbeds.map((embedUrl) => (
              <iframe
                class="post-youtube"
                src={embedUrl}
                width="560"
                height="315"
                title="YouTube video player"
                frameborder="0"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            ))}
          </div>
        )
      }
    </div>
  </article>
  {
    related.length > 0 && (
      <section class="related-posts">
        <h2>関連記事</h2>
        <ul>
          {
            related.map((rel) => (
              <li>
                <a href={`/easy-blog/posts/${rel.slug}/`}>{rel.data.title}</a>
              </li>
            ))
          }
        </ul>
      </section>
    )
  }
</BaseLayout>