---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Awaited<ReturnType<typeof getCollection>>[number];
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  pageUrl={new URL(Astro.url.pathname, Astro.site).href}
>
  <nav class="breadcrumb">
    <a href="/easy-blog/">← 記事一覧</a>
  </nav>
  <article class="post">
    <header>
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString("ja-JP")}
      </time>
      <h1>{post.data.title}</h1>
      {
        post.data.tags.length > 0 && (
          <ul class="tags">
            {post.data.tags.map((tag) => <li>#{tag}</li>)}
          </ul>
        )
      }
      <p class="post-source">
        レビュー元: <a href={post.data.url} rel="noopener">{post.data.url}</a>
      </p>
    </header>
    {post.data.image && (
      <img class="post-og-image" src={post.data.image} alt="" loading="eager" />
    )}
    <div class="post-body">
      <Content />
      {
        post.data.youtube?.length > 0 && (
          <div class="post-embeds">
            {post.data.youtube.map((embedUrl) => (
              <iframe
                class="post-youtube"
                src={embedUrl}
                width="560"
                height="315"
                title="YouTube video player"
                frameborder="0"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            ))}
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>